            "FIND-S Algorithm\n",
            "-----------------\n",
            "Hypothesis: ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same']\n",
            "Hypothesis: ['Sunny', 'Warm', '?', 'Strong', 'Warm', 'Same']\n",
            "Hypothesis: ['Sunny', 'Warm', '?', 'Strong', '?', '?']\n",
            "\n",
            "Final Most Specific Hypothesis:\n",
            "['Sunny', 'Warm', '?', 'Strong', '?', '?']\n"
          ]
        }
      ],
      "source": [
        "# FIND-S Algorithm\n",
        "\n",
        "data = [\n",
        "    [\"Sunny\", \"Warm\", \"Normal\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Warm\", \"Same\", \"Yes\"],\n",
        "    [\"Rainy\", \"Cold\", \"High\", \"Strong\", \"Warm\", \"Change\", \"No\"],\n",
        "    [\"Sunny\", \"Warm\", \"High\", \"Strong\", \"Cool\", \"Change\", \"Yes\"]\n",
        "]\n",
        "\n",
        "# Initial hypothesis\n",
        "h = [\"Ø\", \"Ø\", \"Ø\", \"Ø\", \"Ø\", \"Ø\"]\n",
        "\n",
        "print(\"FIND-S Algorithm\")\n",
        "print(\"-----------------\")\n",
        "\n",
        "# Process each training example\n",
        "for row in data:\n",
        "\n",
        "    attributes = row[:-1]\n",
        "    target = row[-1]\n",
        "\n",
        "    # Consider only positive examples\n",
        "    if target == \"Yes\":\n",
        "\n",
        "        # First positive example\n",
        "        if h[0] == \"Ø\":\n",
        "            h = attributes.copy()\n",
        "\n",
        "        else:\n",
        "            # Generalize hypothesis\n",
        "            for i in range(len(h)):\n",
        "                if h[i] != attributes[i]:\n",
        "                    h[i] = \"?\"\n",
        "\n",
        "        print(\"Hypothesis:\", h)\n",
        "\n",
        "# Display final hypothesis\n",
        "print(\"\\nFinal Most Specific Hypothesis:\")\n",
        "print(h)"
      ]
    }
  ]

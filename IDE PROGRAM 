        "import csv\n",
        "import math\n",
        "import os\n",
        "from collections import Counter\n",
        "\n",
        "\n",
        "# ---------- Load data ----------\n",
        "def load_csv(path):\n",
        "    # Fallback to local 'ide.csv' if 'play_tennis.csv' is missing but ide.csv exists\n",
        "    if not os.path.exists(path) and os.path.exists(\"/content/ide.csv\"):\n",
        "        path = \"/content/ide.csv\"\n",
        "\n",
        "    # If still missing, we can create a dummy play_tennis.csv for demonstration\n",
        "    if not os.path.exists(path):\n",
        "        print(f\"'{path}' not found. Creating a standard PlayTennis dataset for illustration...\")\n",
        "        dummy_data = (\n",
        "            \"Day,Outlook,Temperature,Humidity,Wind,PlayTennis\\n\"\n",
        "            \"D1,Sunny,Hot,High,Weak,No\\n\"\n",
        "            \"D2,Sunny,Hot,High,Strong,No\\n\"\n",
        "            \"D3,Overcast,Hot,High,Weak,Yes\\n\"\n",
        "            \"D4,Rain,Mild,High,Weak,Yes\\n\"\n",
        "            \"D5,Rain,Cool,Normal,Weak,Yes\\n\"\n",
        "            \"D6,Rain,Cool,Normal,Strong,No\\n\"\n",
        "            \"D7,Overcast,Cool,Normal,Strong,Yes\\n\"\n",
        "            \"D8,Sunny,Mild,High,Weak,No\\n\"\n",
        "            \"D9,Sunny,Cool,Normal,Weak,Yes\\n\"\n",
        "            \"D10,Rain,Mild,Normal,Weak,Yes\\n\"\n",
        "            \"D11,Sunny,Mild,Normal,Strong,Yes\\n\"\n",
        "            \"D12,Overcast,Mild,High,Strong,Yes\\n\"\n",
        "            \"D13,Overcast,Hot,Normal,Weak,Yes\\n\"\n",
        "            \"D14,Rain,Mild,High,Strong,No\\n\"\n",
        "        )\n",
        "        with open(path, \"w\") as f:\n",
        "            f.write(dummy_data)\n",
        "\n",
        "    with open(path, newline=\"\") as f:\n",
        "        return list(csv.DictReader(f))\n",
        "\n",
        "\n",
        "# ---------- Entropy & Information Gain ----------\n",
        "def entropy(rows, target):\n",
        "    total = len(rows)\n",
        "    counts = Counter(r[target] for r in rows)\n",
        "    return -sum((c / total) * math.log2(c / total) for c in counts.values())\n",
        "\n",
        "\n",
        "def information_gain(rows, attr, target):\n",
        "    total = len(rows)\n",
        "    remainder = 0.0\n",
        "    for value in set(r[attr] for r in rows):\n",
        "        subset = [r for r in rows if r[attr] == value]\n",
        "        remainder += (len(subset) / total) * entropy(subset, target)\n",
        "    return entropy(rows, target) - remainder\n",
        "\n",
        "\n",
        "# ---------- Build tree (ID3) ----------\n",
        "def id3(rows, attributes, target, depth=0):\n",
        "    labels = [r[target] for r in rows]\n",
        "\n",
        "    # All examples have the same class -> leaf\n",
        "    if len(set(labels)) == 1:\n",
        "        return labels[0]\n",
        "\n",
        "    # No attributes left -> majority class\n",
        "    if not attributes:\n",
        "        return Counter(labels).most_common(1)[0][0]\n",
        "\n",
        "    # Choose attribute with highest information gain\n",
        "    gains = {a: information_gain(rows, a, target) for a in attributes}\n",
        "    best = max(gains, key=gains.get)\n",
        "\n",
        "    indent = \"  \" * depth\n",
        "    print(f\"{indent}Entropy(S) = {entropy(rows, target):.4f}\")\n",
        "    for a, g in gains.items():\n",
        "        print(f\"{indent}  Gain({a}) = {g:.4f}\")\n",
        "    print(f\"{indent}-> Best attribute: {best}\\n\")\n",
        "\n",
        "    tree = {best: {}}\n",
        "    remaining = [a for a in attributes if a != best]\n",
        "    for value in set(r[best] for r in rows):\n",
        "        subset = [r for r in rows if r[best] == value]\n",
        "        tree[best][value] = id3(subset, remaining, target, depth + 1)\n",
        "    return tree\n",
        "\n",
        "\n",
        "# ---------- Classify ----------\n",
        "def classify(tree, sample):\n",
        "    if not isinstance(tree, dict):\n",
        "        return tree\n",
        "    attr = next(iter(tree))\n",
        "    value = sample[attr]\n",
        "    if value not in tree[attr]:\n",
        "        return None  # unseen attribute value\n",
        "    return classify(tree[attr][value], sample)\n",
        "\n",
        "\n",
        "# ---------- Pretty print ----------\n",
        "def print_tree(tree, indent=\"\"):\n",
        "    if not isinstance(tree, dict):\n",
        "        print(indent + \"->\", tree)\n",
        "        return\n",
        "    attr = next(iter(tree))\n",
        "    for value, subtree in tree[attr].items():\n",
        "        print(f\"{indent}[{attr} = {value}]\")\n",
        "        print_tree(subtree, indent + \"    \")\n",
        "\n",
        "\n",
        "# ---------- Main ----------\n",
        "if __name__ == \"__main__\":\n",
        "    data = load_csv(\"play_tennis.csv\")\n",
        "    # Determine target variable name dynamically if using custom CSV keys\n",
        "    target = \"PlayTennis\" if \"PlayTennis\" in data[0] else list(data[0].keys())[-1]\n",
        "    attributes = [c for c in data[0].keys() if c != target and c != \"Day\"]\n",
        "\n",
        "    print(\"=== Building the decision tree ===\\n\")\n",
        "    tree = id3(data, attributes, target)\n",
        "\n",
        "    print(\"=== Final Decision Tree ===\")\n",
        "    print_tree(tree)\n",
        "\n",
        "    new_sample = {\"Outlook\": \"Sunny\", \"Temperature\": \"Cool\",\n",
        "                  \"Humidity\": \"High\", \"Wind\": \"Strong\"}\n",
        "    print(\"\\n=== Classifying new sample ===\")\n",
        "    print(new_sample)\n",
        "    print(\"Prediction:\", target, \"=\", classify(tree, new_sample))"
      ]
    }
